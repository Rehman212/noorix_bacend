generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  BASIC
  PREMIUM
  GOLDEN
}

enum TopupStatus {
  PENDING
  ADDED
}

enum BookingStatus {
  REQUESTED
  SCHEDULED
  CONFIRMED
  COMPLETED
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         Role      @default(USER)
  plan         Plan      @default(PREMIUM)
  wallet       Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  topups       Topup[]
  workLogs     WorkLog[]
  bookings     Booking[]
}

model Topup {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  method    String      @default("Bank Alfalah QR")
  status    TopupStatus @default(PENDING)
  createdAt DateTime    @default(now())
}

model WorkLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  title     String
  kind      String
  note      String   @default("")
  status    String
  createdAt DateTime @default(now())
}

model Booking {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  kind      String
  whenLabel String
  place     String
  tech      String
  status    BookingStatus @default(REQUESTED)
  createdAt DateTime      @default(now())
}
